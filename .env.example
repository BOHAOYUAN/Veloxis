# Public production origin, without a trailing slash. Required for canonical URLs and sitemap output.
NEXT_PUBLIC_SITE_URL=https://veloxis.lumiere-private.com

# LIVE one-unit Dodo product checkout only (https://checkout.dodopayments.com/buy/pdt_...?quantity=1).
# Test links are rejected by public enrollment. Sandbox rehearsal link is in docs/PAYMENT_REHEARSAL.md.
# Keep blank until the release gate passes. Do not add API keys here.
NEXT_PUBLIC_DODO_PILOT_URL=

# Public email used for pilot questions, delivery, refunds, and privacy requests.
NEXT_PUBLIC_CONTACT_EMAIL=haoyuanbo626@gmail.com

# Keep false while the public site is hosted on a non-commercial plan.
# Enable only after production moves to a plan that permits commercial use.
PILOT_OFFER_PUBLISHED=false

# Keep false until sandbox payment, receipt, refund and manual delivery are verified.
# Changing this build-time setting requires a rebuild. Public demo stays available.
PILOT_ENROLLMENT_OPEN=false
